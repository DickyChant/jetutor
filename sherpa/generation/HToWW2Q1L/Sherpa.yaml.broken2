# JetClass-SHERPA: HToWW2Q1L (boosted H -> WW -> q q' l nu)  [FIXED decay forcing]
# Off-shell Higgs -> 2-body 25,24,-24 is invalid -> use the 3-body h -> W(on-shell)+qq'
# (off-shell W hadronic), then force the on-shell W -> l nu  => final state q q' l nu.
# Full event generation: ME (Comix) + hard decays + PS + hadronization + UE -> HepMC3. 13 TeV.
BEAMS: 2212
BEAM_ENERGIES: 6500
EVENTS: 1000
ME_GENERATORS: [Comix]
PDF_LIBRARY: LHAPDFSherpa
PDF_SET: NNPDF23_lo_as_0130_qed
MPI_PDF_LIBRARY: LHAPDFSherpa
MPI_PDF_SET: NNPDF23_lo_as_0130_qed
EVENT_OUTPUT: HepMC3_GenEvent[events]
PARTICLE_DATA: {25: {Mass: 125.0, Width: 0}, 6: {Width: 0}}
HARD_DECAYS:
  Enabled: true
  Use_HO_SM_Widths: false
  Apply_Branching_Ratios: false
  Channels:
    # h -> W(on-shell) + q q' (off-shell W hadronic)
    25,-24,2,-1: {Status: 2}
    25,-24,4,-3: {Status: 2}
    25,24,-2,1: {Status: 2}
    25,24,-4,3: {Status: 2}
    # on-shell W -> l nu (e/mu)  (=> q q' + l nu)
    # NOTE: Sherpa orders the channel as (W, nu, l): 24,12,-11 = W+ -> ve e+  (NOT 24,-11,12).
    24,12,-11: {Status: 2}
    24,14,-13: {Status: 2}
    -24,-12,11: {Status: 2}
    -24,-14,13: {Status: 2}
PROCESSES:
- 93 93 -> 12 -12 25:
    Order: {QCD: 0, EW: 3}
SELECTORS:
- [PT, 25, 450.0, E_CMS]
- [Eta, 25, -2.5, 2.5]
